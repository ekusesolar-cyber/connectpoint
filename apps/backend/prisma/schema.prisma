generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  hotspot_owner
}

enum KYCStatus {
  pending
  approved
  rejected
}

enum PackageType {
  time
  data
  speed
  unlimited
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  completed
}

enum SubscriptionPlan {
  free
  starter
  pro
  enterprise
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole
  fullName       String         @map("full_name")
  phone          String?
  avatarUrl      String?        @map("avatar_url")
  isActive       Boolean        @default(true) @map("is_active")
  emailVerifiedAt DateTime?     @map("email_verified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  kycProfile        KYCProfile?
  hotspots          Hotspot[]
  ownedTransactions Transaction[] @relation("OwnerTransactions")
  withdrawals       Withdrawal[]
  processedWithdrawals Withdrawal[] @relation("ProcessedBy")
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  reviewedKyc       KYCProfile[]  @relation("KYCReviewer")

  @@map("users")
}

model KYCProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  businessName      String?   @map("business_name")
  businessType      String?   @map("business_type")
  businessAddress   String?   @map("business_address")
  governmentIdType  String?   @map("government_id_type")
  governmentIdNumber String?  @map("government_id_number")
  idDocumentUrl     String?   @map("id_document_url")
  utilityBillUrl    String?   @map("utility_bill_url")
  kycStatus         KYCStatus @default(pending) @map("kyc_status")
  rejectionReason   String?   @map("rejection_reason")
  submittedAt       DateTime? @map("submitted_at")
  reviewedById      String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user     User  @relation(fields: [userId], references: [id])
  reviewedBy User? @relation("KYCReviewer", fields: [reviewedById], references: [id])

  @@map("kyc_profiles")
}

model Hotspot {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  name           String
  address        String?
  city           String?
  country        String   @default("Cameroon")
  latitude       Float?
  longitude      Float?
  routerIp       String?  @map("router_ip")
  routerType     String   @default("MikroTik") @map("router_type")
  routerSecret   String?  @map("router_secret")
  nasIdentifier  String?  @map("nas_identifier")
  isActive       Boolean  @default(true) @map("is_active")
  qrCodeUrl      String?  @map("qr_code_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id])
  packages      Package[]
  vouchers      Voucher[]
  sessions      Session[]
  transactions  Transaction[]
  advertisements Advertisement[]

  @@map("hotspots")
}

model Package {
  id              String      @id @default(uuid()) @db.Uuid
  hotspotId       String      @map("hotspot_id") @db.Uuid
  name            String
  description     String?
  type            PackageType
  price           Float
  currency        String      @default("XAF")
  durationMinutes Int?        @map("duration_minutes")
  dataLimitMb     Int?        @map("data_limit_mb")
  speedLimitKbps  Int?        @map("speed_limit_kbps")
  isActive        Boolean     @default(true) @map("is_active")
  isPaid          Boolean     @default(true) @map("is_paid")
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  hotspot      Hotspot      @relation(fields: [hotspotId], references: [id])
  vouchers     Voucher[]
  sessions     Session[]
  transactions Transaction[]

  @@map("packages")
}

model Voucher {
  id        String    @id @default(uuid()) @db.Uuid
  packageId String?   @map("package_id") @db.Uuid
  hotspotId String    @map("hotspot_id") @db.Uuid
  code      String    @unique
  pin       String?
  isUsed    Boolean   @default(false) @map("is_used")
  usedById  String?   @map("used_by")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime? @map("expires_at")
  createdBy String?   @map("created_by")
  batchId   String?   @map("batch_id")
  createdAt DateTime  @default(now()) @map("created_at")

  package  Package? @relation(fields: [packageId], references: [id])
  hotspot  Hotspot  @relation(fields: [hotspotId], references: [id])
  sessions Session[]
  transactions Transaction[]

  @@map("vouchers")
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String?
  email       String?
  macAddress  String?   @map("mac_address")
  deviceName  String?   @map("device_name")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sessions     Session[]
  transactions Transaction[]

  @@map("customers")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  hotspotId        String    @map("hotspot_id") @db.Uuid
  packageId        String?   @map("package_id") @db.Uuid
  voucherId        String?   @map("voucher_id") @db.Uuid
  radiusSessionId  String?   @map("radius_session_id")
  nasIpAddress     String?   @map("nas_ip_address")
  framedIpAddress  String?   @map("framed_ip_address")
  macAddress       String?   @map("mac_address")
  username         String
  password         String?
  sessionStart     DateTime? @map("session_start")
  sessionEnd       DateTime? @map("session_end")
  dataUsedUp       Int       @default(0) @map("data_used_up")
  dataUsedDown     Int       @default(0) @map("data_used_down")
  dataTotal        Int       @default(0) @map("data_total")
  timeUsedSeconds  Int       @default(0) @map("time_used_seconds")
  timeTotalSeconds Int       @default(0) @map("time_total_seconds")
  isActive         Boolean   @default(true) @map("is_active")
  isExpired        Boolean   @default(false) @map("is_expired")
  disconnectReason String?   @map("disconnect_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [customerId], references: [id])
  hotspot     Hotspot   @relation(fields: [hotspotId], references: [id])
  package     Package?  @relation(fields: [packageId], references: [id])
  voucher     Voucher?  @relation(fields: [voucherId], references: [id])

  @@map("sessions")
}

model Transaction {
  id              String        @id @default(uuid()) @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  hotspotId       String?       @map("hotspot_id") @db.Uuid
  ownerId         String?       @map("owner_id") @db.Uuid
  packageId       String?       @map("package_id") @db.Uuid
  voucherId       String?       @map("voucher_id") @db.Uuid
  amount          Float
  currency        String        @default("XAF")
  paymentProvider String?       @map("payment_provider")
  paymentReference String?      @map("payment_reference")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  platformFee     Float         @default(0) @map("platform_fee")
  ownerEarnings   Float         @default(0) @map("owner_earnings")
  metadata        Json?         @db.JsonB
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  hotspot  Hotspot?  @relation(fields: [hotspotId], references: [id])
  owner    User?     @relation("OwnerTransactions", fields: [ownerId], references: [id])
  package  Package?  @relation(fields: [packageId], references: [id])
  voucher  Voucher?  @relation(fields: [voucherId], references: [id])

  @@map("transactions")
}

model Withdrawal {
  id            String            @id @default(uuid()) @db.Uuid
  ownerId       String            @map("owner_id") @db.Uuid
  amount        Float
  bankName      String?           @map("bank_name")
  accountNumber String?           @map("account_number")
  accountName   String?           @map("account_name")
  status        WithdrawalStatus  @default(pending)
  processedById String?           @map("processed_by") @db.Uuid
  processedAt   DateTime?         @map("processed_at")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  owner       User  @relation(fields: [ownerId], references: [id])
  processedBy User? @relation("ProcessedBy", fields: [processedById], references: [id])

  @@map("withdrawals")
}

model Advertisement {
  id              String   @id @default(uuid()) @db.Uuid
  hotspotId       String?  @map("hotspot_id") @db.Uuid
  title           String
  imageUrl        String?  @map("image_url")
  targetUrl       String?  @map("target_url")
  durationSeconds Int      @default(15) @map("duration_seconds")
  isActive        Boolean  @default(true) @map("is_active")
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  hotspot Hotspot? @relation(fields: [hotspotId], references: [id])

  @@map("advertisements")
}

model Subscription {
  id            String           @id @default(uuid()) @db.Uuid
  ownerId       String           @map("owner_id") @db.Uuid
  planName      SubscriptionPlan @default(free) @map("plan_name")
  price         Float            @default(0)
  maxHotspots   Int              @default(1) @map("max_hotspots")
  commissionRate Float           @default(10) @map("commission_rate")
  billingCycle  String           @default("monthly") @map("billing_cycle")
  startsAt      DateTime?        @map("starts_at")
  expiresAt     DateTime?        @map("expires_at")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])

  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
